# Normalize all text files to LF in the repo AND in the working tree.
# Without `eol=lf`, Git for Windows' system-wide core.autocrlf=true rewrites
# checkouts to CRLF, which makes Prettier fail on every line of every file.
* text=auto eol=lf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks   binary

# Windows-only scripts must keep CRLF to run.
*.bat   text eol=crlf
*.cmd   text eol=crlf
