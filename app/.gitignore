# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local native module build output. `modules/` itself is source and must be
# committed - autolinking reads it - but Gradle/CMake write their artifacts
# inside it, which the generated /android ignore above does not cover.
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# Store screenshots are real usage from the developer's phone. They are uploaded
# to the Play listing by hand and are not repo content.
store/screenshots/
