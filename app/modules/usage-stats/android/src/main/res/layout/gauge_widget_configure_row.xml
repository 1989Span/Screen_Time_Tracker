<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/gauge_widget_row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1D1F20"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/gauge_widget_row_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7B7D7E"
        android:textSize="13sp" />
  </LinearLayout>

  <!-- Marks the current choice when reconfiguring. -->
  <TextView
      android:id="@+id/gauge_widget_row_check"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:importantForAccessibility="no"
      android:text="✓"
      android:textColor="#416180"
      android:textSize="18sp"
      android:visibility="gone" />
</LinearLayout>
