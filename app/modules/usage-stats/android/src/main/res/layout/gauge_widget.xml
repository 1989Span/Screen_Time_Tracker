<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 home-screen widget: which range, and its total. Colours follow src/theme.ts
     (text #1d1f20, accent700 #416180). The value shrinks to fit narrow cells
     rather than truncating: autosize on Android 8+, a fixed size below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gauge_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

  <TextView
      android:id="@+id/gauge_widget_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.08"
      android:maxLines="1"
      android:text="@string/gauge_widget_name"
      android:textAllCaps="true"
      android:textColor="#7B7D7E"
      android:textSize="11sp" />

  <TextView
      android:id="@+id/gauge_widget_value"
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:autoSizeMaxTextSize="30sp"
      android:autoSizeMinTextSize="14sp"
      android:autoSizeTextType="uniform"
      android:fontFamily="sans-serif-condensed"
      android:gravity="center_vertical|start"
      android:maxLines="1"
      android:text="@string/gauge_widget_placeholder"
      android:textColor="#1D1F20"
      android:textSize="26sp"
      android:textStyle="bold"
      tools:targetApi="o" />

  <TextView
      android:id="@+id/gauge_widget_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:fontFamily="sans-serif-medium"
      android:maxLines="2"
      android:textColor="#416180"
      android:textSize="13sp"
      android:visibility="gone" />
</LinearLayout>
