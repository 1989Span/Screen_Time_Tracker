<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <!-- Reading per-app screen time. This is a *special* permission, not a runtime
       one: it cannot be requested with requestPermissions(), and the user must
       grant it by hand in Settings > Special app access > Usage access. The
       tools:ignore is required because the platform reserves the permission for
       system apps, so lint flags the declaration even though it is the
       documented way for a normal app to ask for usage access. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
                   tools:ignore="ProtectedPermissions" />

  <!-- Android 11+ hides other packages unless they match a declared query. This
       one makes every app with a home-screen icon visible, which is exactly the
       set the picker offers: offerableApps() drops anything without a launcher
       icon before the user sees it.

       QUERY_ALL_PACKAGES was declared here too and is deliberately gone. It only
       added packages the picker filtered straight back out, and Play treats it as
       a restricted permission: it needs a declaration form and is rejected when a
       narrower <queries> block would do, as this one does. Do not add it back
       without a feature that genuinely needs to see non-launchable packages. -->
  <!-- Hourly screen-time nudges. POST_NOTIFICATIONS is a runtime permission on
       Android 13 and later, requested once from the app. RECEIVE_BOOT_COMPLETED
       re-arms the check after a reboot, which clears pending alarms. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!-- Home-screen widget. Exported because the system widget host has to
         deliver APPWIDGET_UPDATE to it. A stray update from another app only
         causes a harmless redraw. -->
    <receiver
        android:name="com.span1989.gauge.usagestats.widget.GaugeWidgetProvider"
        android:exported="true"
        android:label="@string/gauge_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/gauge_widget_info" />
    </receiver>

    <!-- Range chooser shown when the widget is placed or reconfigured. Exported
         because the launcher starts it. The activity checks that the widget id
         belongs to Gauge before acting on it. Its own empty task affinity keeps
         it from pulling the app's task forward. -->
    <activity
        android:name="com.span1989.gauge.usagestats.widget.GaugeWidgetConfigureActivity"
        android:excludeFromRecents="true"
        android:exported="true"
        android:taskAffinity=""
        android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <!-- Hourly nudge checks: its own alarm (an explicit intent), plus reboot and
         app update, which both clear pending alarms. Not exported: the system
         still delivers those broadcasts, and no other app can trigger a check. -->
    <receiver
        android:name="com.span1989.gauge.usagestats.nudge.NudgeReceiver"
        android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
