<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <!-- Reading per-app screen time. This is a *special* permission, not a runtime
       one: it cannot be requested with requestPermissions(), and the user must
       grant it by hand in Settings > Special app access > Usage access. The
       tools:ignore is required because the platform reserves the permission for
       system apps, so lint flags the declaration even though it is the
       documented way for a normal app to ask for usage access. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
                   tools:ignore="ProtectedPermissions" />

  <!-- Android 11+ hides other packages unless they match a declared query. This
       one makes every app with a home-screen icon visible, which is exactly the
       set the picker offers: offerableApps() drops anything without a launcher
       icon before the user sees it.

       QUERY_ALL_PACKAGES was declared here too and is deliberately gone. It only
       added packages the picker filtered straight back out, and Play treats it as
       a restricted permission: it needs a declaration form and is rejected when a
       narrower <queries> block would do, as this one does. Do not add it back
       without a feature that genuinely needs to see non-launchable packages. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
</manifest>
